[Unit]
Description=Klipboard Standalone Clipboard Manager
PartOf=graphical-session.target
After=plasma-core.target

[Service]
Type=dbus
BusName=org.kde.klipper
ExecStart=@KDE_INSTALL_FULL_BINDIR@/klipper
Restart=on-failure
RestartSec=1s
Slice=session.slice
TimeoutStopSec=10s

[Install]
WantedBy=plasma-workspace.target
Alias=klipboard.service
