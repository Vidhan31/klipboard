pkgname=klipboard
pkgver=6.8.2
pkgrel=1
pkgdesc='Standalone clipboard manager based on KDE Klipper'
arch=('x86_64' 'aarch64')
url='https://github.com/klipboard/klipper'
license=('GPL-2.0-or-later' 'BSD-3-Clause')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'ki18n' 'kconfig' 'kcoreaddons' 'kdbusaddons' 'kglobalaccel' 'kguiaddons' 'kiconthemes' 'kio' 'knotifications' 'kprison' 'kservice' 'kstatusnotifieritem' 'kwidgetsaddons' 'kwindowsystem' 'kxmlgui' 'plasma' 'wayland' 'libei' 'zlib')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'qt6-tools' 'plasma-wayland-protocols')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')
build() {
  cmake -S "$srcdir/klipper-$pkgver" -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DINSTALL_AUTOSTART=OFF -DINSTALL_KCONF_UPDATE=OFF -DWITH_X11=ON
  cmake --build build
}
package() { DESTDIR="$pkgdir" cmake --install build; }
